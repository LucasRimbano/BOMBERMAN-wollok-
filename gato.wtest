import wollok.game.*
import pepita.*
import gato.*
import movimientos.*

describe "Tests de Gato" {

	method initialize() {
		game.clear()
	}

	method prepararTablero() {
		game.width(13)
		game.height(11)
	}

	method prepararPepitaLejos() {
		self.prepararTablero()
		pepita.position(game.at(1, 1))
	}

	test "El gato muestra su imagen segun tipo y direccion" {
		const unGato = new Gato(position = game.at(5, 5), tipo = "cal")

		assert.equals("calfren.png", unGato.image())
	}

	test "El gato no es pared" {
		const unGato = new Gato(position = game.at(5, 5), tipo = "cal")

		assert.equals(false, unGato.esPared())
	}

	test "El gato se identifica como gato" {
		const unGato = new Gato(position = game.at(5, 5), tipo = "cal")

		assert.equals(true, unGato.esGato())
	}

	test "El gato ejecuta movimiento hacia la derecha" {
		self.prepararPepitaLejos()
		const unGato = new Gato(position = game.at(5, 5), tipo = "cal")

		unGato.ejecutarMovimiento(movimientoDerecha)

		assert.equals(game.at(6, 5), unGato.position())
		assert.equals("calder.png", unGato.image())
	}

	test "El gato ejecuta movimiento hacia la izquierda" {
		self.prepararPepitaLejos()
		const unGato = new Gato(position = game.at(5, 5), tipo = "cal")

		unGato.ejecutarMovimiento(movimientoIzquierda)

		assert.equals(game.at(4, 5), unGato.position())
		assert.equals("calizq.png", unGato.image())
	}

	test "El gato ejecuta movimiento hacia arriba" {
		self.prepararPepitaLejos()
		const unGato = new Gato(position = game.at(5, 5), tipo = "cal")

		unGato.ejecutarMovimiento(movimientoArriba)

		assert.equals(game.at(5, 6), unGato.position())
		assert.equals("caltras.png", unGato.image())
	}

	test "El gato ejecuta movimiento hacia abajo" {
		self.prepararPepitaLejos()
		const unGato = new Gato(position = game.at(5, 5), tipo = "cal")

		unGato.ejecutarMovimiento(movimientoAbajo)

		assert.equals(game.at(5, 4), unGato.position())
		assert.equals("calfren.png", unGato.image())
	}

	test "El gato se mueve a una posicion valida" {
		self.prepararPepitaLejos()
		const unGato = new Gato(position = game.at(5, 5), tipo = "cal")

		unGato.mover()

		assert.that(unGato.position() != game.at(5, 5))
	}

	test "Un gato nuevo esta vivo" {
		const unGato = new Gato(position = game.at(5, 5), tipo = "cal")

		assert.that(unGato.estaVivo())
	}

	test "Un gato muerto no esta vivo" {
		const unGato = new Gato(position = game.at(5, 5), tipo = "cal")

		unGato.morir()

		assert.notThat(unGato.estaVivo())
	}

	test "Un gato muerto no se mueve" {
		self.prepararPepitaLejos()
		const unGato = new Gato(position = game.at(5, 5), tipo = "cal")
		unGato.morir()

		unGato.mover()

		assert.equals(game.at(5, 5), unGato.position())
	}

}